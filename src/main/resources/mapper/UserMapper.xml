<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.group2.cms.mapper.UserMapper">
    <delete id="deleteUserById">
        delete * FROM base_user where id = #{id}
    </delete>

    <select id="selectUserByUsername" resultType="com.group2.cms.entity.User">
        select * from base_user where username = #{username}
    </select>
    <select id="getById" resultType="com.group2.cms.entity.User">
        select * FROM base_user where id = #{id}
    </select>
</mapper>
